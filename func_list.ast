[start]
[def_list, [name, LIST1], [fields, [[id, SEASON_ID, [attr, [*OUT]]], [id, PLAYER_ID, [attr, [*OUT]]], [id, PLAYER_NAME, [attr, [*OUT]]], [id, NFL_TEAM_ID, [attr, [*OUT]]], [id, NFL_TEAM_ID3, [attr, [*OUT]]], [id, POSITION_ID, [attr, [*OUT]]]]], [counter, [id, LISTCOUNT1]]]
[assign, [id, LIMIT], [num, 20]]
[if, [comp, [id, STD_BUTTON], [logic_op, ==], [lit1, 'DETAIL']]]
[exchange, [fields, [[id, START], [id, STD_BUTTON], [id, SEASON_ID], [id, PLAYER_ID]]]]
[call, [name, FUNC_DETAIL]]
[endif]
[if, [comp, [id, STD_BUTTON], [logic_op, ==], [lit1, 'FIRST']]]
[assign, [id, START], [num, 0]]
[endif]
[if, [comp, [id, STD_BUTTON], [logic_op, ==], [lit1, 'PREV']]]
[assign, [id, START], [sub, [id, START], [id, LIMIT]]]
[endif]
[if, [comp, [id, STD_BUTTON], [logic_op, ==], [lit1, 'NEXT']]]
[assign, [id, START], [add, [id, START], [id, LIMIT]]]
[endif]
[if, [comp, [id, STD_BUTTON], [logic_op, ==], [lit1, 'LAST']]]
[assign, [id, START], [num, 0]]
[select, [name, nfl_player_defense], *ALL, N/A, N/A, N/A, [N/A, N/A]]
[assign, [id, START], [add, [id, START], [num, 1]]]
[endselect]
[assign, [id, START], [sub, [id, START], [id, LIMIT]]]
[endif]
[if, [comp, [id, START], [logic_op, <=], [num, 0]]]
[assign, [id, START], [num, 0]]
[endif]
